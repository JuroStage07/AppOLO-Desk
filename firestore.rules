rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


   function authed() {
      return request.auth != null;
    }

    // =========================
    // Helpers de perfil / scope (tenantId + company)
    // =========================
    function userExists(uid) {
      return exists(/databases/$(database)/documents/profiles/$(uid));
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/profiles/$(uid)).data;
    }

    function requesterProfile() {
      return userDoc(request.auth.uid);
    }

    function isAdminRequester() {
      return authed()
        && userExists(request.auth.uid)
        && requesterProfile().role in ['administrativo','dev'];
    }

    function hasPerm(permKey) {
      return authed()
        && userExists(request.auth.uid)
        && ('permisos' in requesterProfile())
        && (permKey in requesterProfile().permisos)
        && requesterProfile().permisos[permKey] == true;
    }

    function sameTenantCompanyData(data) {
      return authed()
        && userExists(request.auth.uid)
        && data.tenantId is string
        && data.company is string
        && requesterProfile().tenantId == data.tenantId
        && requesterProfile().company == data.company;
    }

    // ✅ Admin/Dev o permiso mantenimiento
    function canGestionEquipos() {
      return authed() && (
        isAdminRequester() || hasPerm('mantenimiento')
      );
    }

function canMantenimientoOT() {
      return authed() && (
        isAdminRequester() ||
        hasPerm('mantenimiento')
      );
    }

    function validOTState(s) {
      return s is string
        && s in ['Solicitada', 'En proceso', 'En revisión', 'Finalizada'];
    }

function solicitudOtCreateTenantCompanyOk() {
      return !('tenantId' in request.resource.data)
        || !('company' in request.resource.data)
        || (
          request.resource.data.tenantId is string
          && request.resource.data.company is string
          && (
            (request.resource.data.tenantId == '' && request.resource.data.company == '')
            || sameTenantCompanyData(request.resource.data)
          )
        );
    }
    
    function canDocumentacion() {
      return authed() && (
        isAdminRequester()
        || hasPerm('documentacion')
        || hasPerm('documentos')
      );
    }

    function canUploadDocumentacionAdmin() {
      return isAdminRequester();
    }

    function canReadDocumentacion() {
      return canDocumentacion()
        && sameTenantCompanyData(resource.data);
    }

    function canCreateDocumentacion() {
      return canUploadDocumentacionAdmin()
        && sameTenantCompanyData(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
    }

    function canUpdateDocumentacion() {
      return canUploadDocumentacionAdmin()
        && sameTenantCompanyData(resource.data)
        && sameTenantCompanyData(request.resource.data);
    }
    
    // =========================
    // Aperturas helpers GLOBAL
    // =========================
    function aperturaLegacyExists(apId) {
      return exists(/databases/$(database)/documents/aperturas/$(apId));
    }

    function aperturaRecepcionExists(apId) {
      return exists(/databases/$(database)/documents/aperturasRecepcion/$(apId));
    }

    function aperturaGlobalExists(apId) {
      return aperturaLegacyExists(apId) || aperturaRecepcionExists(apId);
    }

    function aperturaLegacyDoc(apId) {
      return get(/databases/$(database)/documents/aperturas/$(apId)).data;
    }

    function aperturaRecepcionDoc(apId) {
      return get(/databases/$(database)/documents/aperturasRecepcion/$(apId)).data;
    }

    function aperturaGlobalDoc(apId) {
      return aperturaLegacyExists(apId)
        ? aperturaLegacyDoc(apId)
        : aperturaRecepcionDoc(apId);
    }

    function isOwnerAperturaGlobal(apId) {
      return authed()
        && aperturaGlobalExists(apId)
        && aperturaGlobalDoc(apId).creadoPor == request.auth.uid;
    }

    function isAperturaAssignedToMeGlobal(apId) {
      return authed()
        && aperturaGlobalExists(apId)
        && ('assignedTo' in aperturaGlobalDoc(apId))
        && aperturaGlobalDoc(apId).assignedTo == request.auth.uid;
    }

    // =========================
    // Catálogo global de subtareas
    // =========================
    match /subtaskList/{subtaskId} {

      allow get, list: if canMantenimientoOT();

      allow create: if canMantenimientoOT()
        && request.resource.data.keys().hasOnly([
          'name',
          'nameLower',
          'active',
          'createdAt',
          'updatedAt',
          'createdBy',
          'createdByName'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.trim().size() > 0
        && request.resource.data.nameLower is string
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && request.resource.data.active is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string;

      allow update: if canMantenimientoOT()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'name',
          'nameLower',
          'active',
          'updatedAt'
        ])
        && (
          !request.resource.data.diff(resource.data).changedKeys().hasAny(['name']) ||
          (
            request.resource.data.name is string &&
            request.resource.data.name.trim().size() > 0
          )
        )
        && (
          !request.resource.data.diff(resource.data).changedKeys().hasAny(['nameLower']) ||
          (
            request.resource.data.nameLower is string &&
            request.resource.data.nameLower == request.resource.data.name.lower()
          )
        )
        && (
          !request.resource.data.diff(resource.data).changedKeys().hasAny(['active']) ||
          request.resource.data.active is bool
        )
        && (
          !request.resource.data.diff(resource.data).changedKeys().hasAny(['updatedAt']) ||
          request.resource.data.updatedAt is timestamp
        );

      allow delete: if canMantenimientoOT();
    }
    
    // =========================
    // Permisos Recepcion Cofersa
    // =========================
    function canRecepcionCofersa() {
  return authed() && (
    isAdminRequester() || hasPerm('canRecepcionCofersa')
  );
}

    // ✅ Recepción EPA
    function canRecepcionEPA() {
      return authed() && (isAdminRequester() || hasPerm('despachosEPA'));
    }

    // ------------------------------------------------------------------
    // ✅ FIX CLAVE PARA collectionGroup("fotos")
    match /{path=**}/fotos/{fotoId} {
      allow read: if authed();
    }
    
    match /{path=**}/subtareas/{subtareaId} {
      allow read: if canMantenimientoOT();
    }

    // ------------------------------------------------------------------

    // =========================
    // ✅ Acciones de Descarga
    // Colección: accion_descarga/{accionId}
    // =========================
    match /accion_descarga/{accionId} {

      function isAccionOwner() {
        return authed() && (
          (resource.data.creadoPorUid is string && resource.data.creadoPorUid == request.auth.uid) ||
          (resource.data.creadoPor is string && resource.data.creadoPor == request.auth.uid)
        );
      }

      function canTouchByApertura() {
        return authed()
          && resource.data.aperturaId is string
          && (
            isOwnerAperturaGlobal(resource.data.aperturaId) ||
            isAperturaAssignedToMeGlobal(resource.data.aperturaId)
          );
      }

      function canCreateByApertura() {
        return authed()
          && request.resource.data.aperturaId is string
          && (
            isOwnerAperturaGlobal(request.resource.data.aperturaId) ||
            isAperturaAssignedToMeGlobal(request.resource.data.aperturaId)
          );
      }

      function canTouch() {
        return authed() && (
          isAdminRequester() ||
          canRecepcionEPA() ||
          canRecepcionCofersa() ||
          isAccionOwner() ||
          canTouchByApertura()
        );
      }

      allow get, list: if canTouch();

      allow create: if authed()
        && request.resource.data.keys().hasOnly([
          'aperturaId','tenantId','company',
          'creadoPorUid','creadoPorNombre','creadoAt',
          'proveedorNombre','idAnden','nombreAccion',
          'startedAt','completedAt','tipoDescarga','cantidadBultos',
          'starter','starterUid',
          'dayKeyCreado','dayKeyStarted','dayKeyCompleted',
          'totalTimeMs','totalTimeMin','totalTimeTxt',
          'updatedAt'
        ])
        && request.resource.data.aperturaId is string
        && request.resource.data.tenantId is string
        && request.resource.data.company is string
        && request.resource.data.creadoPorUid is string
        && request.resource.data.creadoPorUid == request.auth.uid
        && request.resource.data.creadoPorNombre is string
        && request.resource.data.creadoAt is timestamp
        && (!('proveedorNombre' in request.resource.data) || request.resource.data.proveedorNombre == null || request.resource.data.proveedorNombre is string)
        && (
          !('idAnden' in request.resource.data) ||
          request.resource.data.idAnden == null ||
          request.resource.data.idAnden is string ||
          request.resource.data.idAnden is int ||
          request.resource.data.idAnden is float
        )
        && (!('nombreAccion' in request.resource.data) || request.resource.data.nombreAccion is string)
        && (!('startedAt' in request.resource.data) || request.resource.data.startedAt == null)
        && (!('completedAt' in request.resource.data) || request.resource.data.completedAt == null)
        && (!('tipoDescarga' in request.resource.data) || request.resource.data.tipoDescarga == null)
        && (!('cantidadBultos' in request.resource.data) || request.resource.data.cantidadBultos == null)
        && (!('starter' in request.resource.data) || request.resource.data.starter == null || request.resource.data.starter is string)
        && (!('starterUid' in request.resource.data) || request.resource.data.starterUid == null || request.resource.data.starterUid is string)
        && (!('dayKeyCreado' in request.resource.data) || request.resource.data.dayKeyCreado == null || request.resource.data.dayKeyCreado is string)
        && (!('dayKeyStarted' in request.resource.data) || request.resource.data.dayKeyStarted == null || request.resource.data.dayKeyStarted is string)
        && (!('dayKeyCompleted' in request.resource.data) || request.resource.data.dayKeyCompleted == null || request.resource.data.dayKeyCompleted is string)
        && (!('totalTimeMs' in request.resource.data) || request.resource.data.totalTimeMs == null)
        && (!('totalTimeMin' in request.resource.data) || request.resource.data.totalTimeMin == null)
        && (!('totalTimeTxt' in request.resource.data) || request.resource.data.totalTimeTxt == null)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);

      allow update: if canTouch()
  && request.resource.data.diff(resource.data).changedKeys().hasOnly([
    'startedAt','tipoDescarga','cantidadBultos','completedAt',
    'starter','starterUid','updatedAt',
    'isPaused','pausedAt','pausedTotalMs','totalTimeMs','totalTimeTxt'
  ])
  && (
    !request.resource.data.diff(resource.data).changedKeys().hasAny(['startedAt']) ||
    (
      resource.data.startedAt == null &&
      request.resource.data.startedAt is timestamp &&
      request.resource.data.completedAt == null
    )
  )
  && (
    !request.resource.data.diff(resource.data).changedKeys().hasAny(['tipoDescarga']) ||
    (
      request.resource.data.tipoDescarga is string &&
      request.resource.data.tipoDescarga in ['A granel','Entarimado']
    )
  )
  && (
    !request.resource.data.diff(resource.data).changedKeys().hasAny(['cantidadBultos']) ||
    (
      request.resource.data.cantidadBultos is number &&
      request.resource.data.cantidadBultos > 0
    )
  )
  && (
    !request.resource.data.diff(resource.data).changedKeys().hasAny(['completedAt']) ||
    (
      resource.data.completedAt == null &&
      resource.data.startedAt != null &&
      request.resource.data.completedAt is timestamp &&
      request.resource.data.isPaused == false &&
      request.resource.data.pausedAt == null
    )
  )
  && (
    !request.resource.data.diff(resource.data).changedKeys().hasAny(['starter']) ||
    request.resource.data.starter is string
  )
  && (
    !request.resource.data.diff(resource.data).changedKeys().hasAny(['starterUid']) ||
    request.resource.data.starterUid == request.auth.uid
  )
  && (
    !request.resource.data.diff(resource.data).changedKeys().hasAny(['isPaused']) ||
    (
      resource.data.startedAt != null &&
      resource.data.completedAt == null &&
      request.resource.data.isPaused is bool
    )
  )
  && (
    !request.resource.data.diff(resource.data).changedKeys().hasAny(['pausedAt']) ||
    (
      (request.resource.data.isPaused == true && request.resource.data.pausedAt is timestamp) ||
      (request.resource.data.isPaused == false && request.resource.data.pausedAt == null)
    )
  )
  && (
    !request.resource.data.diff(resource.data).changedKeys().hasAny(['pausedTotalMs']) ||
    (
      request.resource.data.pausedTotalMs is number &&
      request.resource.data.pausedTotalMs >= 0
    )
  )
  && (
    !request.resource.data.diff(resource.data).changedKeys().hasAny(['totalTimeMs']) ||
    (
      request.resource.data.totalTimeMs is number &&
      request.resource.data.totalTimeMs >= 0 &&
      request.resource.data.completedAt != null
    )
  )
  && (
    !request.resource.data.diff(resource.data).changedKeys().hasAny(['totalTimeTxt']) ||
    (
      request.resource.data.totalTimeTxt is string &&
      request.resource.data.completedAt != null
    )
  )
  && (
    !request.resource.data.diff(resource.data).changedKeys().hasAny(['updatedAt']) ||
    request.resource.data.updatedAt is timestamp
  );

      allow delete: if isAdminRequester();
    }

// =========================
    // PESAJE TARIMAS
    // =========================
    match /pesajes/{pesajeId} {

      function canPesaje() {
        return authed();
      }

      /** Email del cliente debe coincidir con el token (o vacío si el proveedor no da email). */
      function validRegistradoEmail() {
        return request.resource.data.registradoPorEmail is string
          && (
            request.auth.token.email == null
              ? request.resource.data.registradoPorEmail == ''
              : request.resource.data.registradoPorEmail == request.auth.token.email
          );
      }

      function validRegistradoNombre() {
        return request.resource.data.registradoPorNombre is string
          && request.resource.data.registradoPorNombre.size() <= 256;
      }

      // Consulta por ID (getDoc con número de tarima)
      allow get: if canPesaje();

      allow list: if false;

      allow create, update: if canPesaje()
        && request.resource.data.keys().hasOnly([
          'numero',
          'peso',
          'unidad',
          'fechaRegistro',
          'registradoPorUid',
          'registradoPorEmail',
          'registradoPorNombre'
        ])
        && request.resource.data.numero is string
        && request.resource.data.numero.size() > 0
        && request.resource.data.numero == pesajeId
        && request.resource.data.peso is number
        && request.resource.data.peso > 0
        && request.resource.data.unidad is string
        && request.resource.data.unidad in ['kg', 'g', 'lb', 'oz', 't']
        && request.resource.data.fechaRegistro is timestamp
        && request.resource.data.registradoPorUid is string
        && request.resource.data.registradoPorUid == request.auth.uid
        && validRegistradoEmail()
        && validRegistradoNombre();

      allow delete: if false;
    }

    // =========================
    // Control de marcas (ControlMarcas.jsx)
    // controlMarcas/{YYYY-MM-DD} + subcolección marcas
    // =========================
    match /controlMarcas/{dayId} {
      allow get: if authed();

      // fecha debe coincidir con el id del doc (YYYY-MM-DD). No exigir createdAt == resource:
      // cada setDoc manda serverTimestamp() nuevos y nunca serían iguales al doc anterior.
      allow create: if authed()
        && request.resource.data.keys().hasOnly(['fecha', 'createdAt', 'updatedAt'])
        && request.resource.data.fecha is string
        && request.resource.data.fecha == dayId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if authed()
        && request.resource.data.keys().hasAll(['fecha', 'createdAt', 'updatedAt'])
        && request.resource.data.fecha is string
        && request.resource.data.fecha == dayId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.fecha == resource.data.fecha;

      allow delete: if false;

      match /marcas/{marcaId} {
        allow get, list: if authed();

        allow create: if authed()
          && request.resource.data.keys().hasOnly([
            'usuarioId',
            'cedula',
            'nombre',
            'empresa',
            'company',
            'motivo',
            'tenantId',
            'tipo',
            'createdAt',
            'fecha',
            'horaTexto'
          ])
          && request.resource.data.usuarioId is string
          && request.resource.data.cedula is string
          && request.resource.data.nombre is string
          && request.resource.data.empresa is string
          && request.resource.data.company is string
          && request.resource.data.motivo is string
          && request.resource.data.tenantId is string
          && request.resource.data.tipo is string
          && request.resource.data.tipo in ['entrada', 'salida']
          && request.resource.data.createdAt is timestamp
          && request.resource.data.fecha is string
          && request.resource.data.horaTexto is string;

        allow update, delete: if false;
      }
    }
    
    // =========================
    // ✅ Dashboard Salud / Recepción (agregado diario)
    // =========================
    match /dashboard_salud_daily/{docId} {

      function sameTenantCompanyProfile() {
        return authed()
          && userExists(request.auth.uid)
          && resource.data.tenantId is string
          && resource.data.company is string
          && userDoc(request.auth.uid).tenantId == resource.data.tenantId
          && userDoc(request.auth.uid).company == resource.data.company;
      }

      allow get, list: if authed() && (
        isAdminRequester()
        || hasPerm('saludOcupacional')
        || canRecepcionCofersa()
        || canRecepcionEPA()
        || sameTenantCompanyProfile()
      );

      allow create, update, delete: if false;
    }

    // ==========================================================
    // ✅ PUSH TOKENS (COLECCIÓN RAÍZ)
    // ==========================================================
    match /pushTokens/{docId} {

      allow get, list: if authed() && (
        isAdminRequester() ||
        (resource.data.userId is string && resource.data.userId == request.auth.uid)
      );

      allow create, update: if authed()
        && request.resource.data.keys().hasOnly([
          'userId','token','updatedAt','platform','projectId'
        ])
        && request.resource.data.userId == request.auth.uid
        && (request.resource.data.token is string)
        && docId.matches('^' + request.auth.uid + '_.+');

      allow delete: if authed() && (
        isAdminRequester() ||
        (resource.data.userId is string && resource.data.userId == request.auth.uid)
      );
    }

    // =========================
    // Chats
    // =========================
    match /chats/{chatId} {
      function isMember() {
        return authed() && request.auth.uid in resource.data.members;
      }
      function isMemberOnCreate() {
        return authed()
          && request.auth.uid in request.resource.data.members
          && request.resource.data.type == 'dm'
          && request.resource.data.members.size() == 2;
      }

      allow create: if isMemberOnCreate();
      allow get, list, update, delete: if isMember();

      match /mensajes/{msgId} {
        function chatMembers() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }

        allow get, list, create: if authed() && request.auth.uid in chatMembers();
        allow delete: if authed() && request.auth.uid in chatMembers();
        allow update: if false;
      }
    }

    // =========================
    // ✅ FICHAS
    // =========================
    match /fichas/{fichaId} {
      allow get: if true;
      allow list: if false;

      allow create: if authed()
        && !exists(/databases/$(database)/documents/fichas/$(fichaId))
        && request.resource.data.keys().hasOnly(['username','uid','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username == request.resource.data.username.lower()
        && request.resource.data.createdAt is timestamp;

      allow update, delete: if isAdminRequester();
    }

    // =========================
    // Profiles
    // =========================
match /profiles/{uid} {
  function isSelfLocal() { return authed() && request.auth.uid == uid; }
  function isAdminDev() {
    return authed()
      && userExists(request.auth.uid)
      && userDoc(request.auth.uid).role in ['administrativo','dev'];
  }
  function isDev() {
    return authed()
      && userExists(request.auth.uid)
      && userDoc(request.auth.uid).role == 'dev';
  }

allow get: if authed() && request.auth.uid == uid;

allow get: if authed()
  && request.auth.uid != uid
  && (isAdminDev() || canMantenimientoOT());
allow list: if isAdminDev() || canMantenimientoOT();

  allow create: if (
    (isSelfLocal()
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.role == 'operativo'
      && request.resource.data.keys().hasOnly([
        'uid',
        'email',
        'username',
        'displayName',
        'numeroFicha',
        'role',
        'active',
        'permisos',
        'createdAt',
        'updatedAt',
        'desiredRole',
        'lastSeenAt',
        'tenantId',
        'company'
      ])
      && request.resource.data.uid is string
      && request.resource.data.email is string
      && request.resource.data.username is string
      && (!('displayName' in request.resource.data) || request.resource.data.displayName is string)
      && (!('numeroFicha' in request.resource.data) || request.resource.data.numeroFicha is string)
      && (!('active' in request.resource.data) || request.resource.data.active is bool)
      && (
        !('permisos' in request.resource.data) || (
          request.resource.data.permisos is map
          && request.resource.data.permisos.keys().hasOnly([
            'saludOcupacional',
            'despachosEPA',
            'canRecepcionCofersa',
            'mantenimiento'
          ])
          && request.resource.data.permisos.saludOcupacional is bool
          && request.resource.data.permisos.despachosEPA is bool
          && request.resource.data.permisos.canRecepcionCofersa is bool
          && request.resource.data.permisos.mantenimiento is bool
        )
      )
      && (!('desiredRole' in request.resource.data) || request.resource.data.desiredRole in ['operativo','administrativo','dev'])
      && (!('tenantId' in request.resource.data) || request.resource.data.tenantId == null || request.resource.data.tenantId in ['CR', 'VNZ'])
      && (!('company' in request.resource.data) || request.resource.data.company == null || request.resource.data.company == 'OLO')
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp
    )
    || isAdminDev()
  );

  allow update: if (
    (isSelfLocal()
      && request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'displayName',
        'numeroFicha',
        'username',
        'email',
        'lastLoginAt',
        'lastSeenAt',
        'device',
        'tenantId',
        'company',
        'updatedAt'
      ])
      && request.resource.data.uid == resource.data.uid
      && (
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['username']) ||
        request.resource.data.username is string
      )
      && (
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['email']) ||
        request.resource.data.email is string
      )
      && (
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['displayName']) ||
        request.resource.data.displayName is string
      )
      && (
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['numeroFicha']) ||
        request.resource.data.numeroFicha is string
      )
      && (
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['tenantId']) ||
        request.resource.data.tenantId == null ||
        request.resource.data.tenantId in ['CR', 'VNZ']
      )
      && (
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['company']) ||
        request.resource.data.company == null ||
        request.resource.data.company == 'OLO'
      )
      && (
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['updatedAt']) ||
        request.resource.data.updatedAt is timestamp
      )
    )
    || isAdminDev()
  );

  allow delete: if isDev();

  match /pushTokens/{token} {
    allow read: if isSelfLocal();

    allow create, update: if isSelfLocal()
      && request.resource.data.keys().hasOnly([
        'token', 'updatedAt', 'platform', 'projectId'
      ])
      && request.resource.data.token == token;

    allow delete: if isSelfLocal();
	 }
 }

// =========================
    // username
    // =========================
match /usernames/{username} {
  allow get: if true;
  allow list: if false;

allow create: if authed()
  && request.resource.data.keys().hasOnly([
    'uid', 'email', 'username', 'createdAt'
  ])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.email is string
    && request.resource.data.username is string;

  allow update, delete: if isAdminRequester();
}
    // =========================
    //  LEGACY users
    // =========================
    match /users/{uid} {
      allow get: if authed() && (request.auth.uid == uid || isAdminRequester());
      allow list: if isAdminRequester();
      allow create, update, delete: if false;
    }

    // =========================
    // Despachos
    // =========================
    match /despachos/{despachoId} {
      allow read, write: if authed();

      match /items/{itemId} {
        allow read, write: if authed();
      }

      match /fotos/{fotoId}   { allow read, write: if authed(); }
      match /layout/{docId}   { allow read, write: if authed(); }
    }

    // =========================
    // Equipos (PanelEquiposMantenimiento.jsx)
    // Colección: equipos/{equipoId}
    // =========================
    match /equipos/{equipoId} {
      allow get, list: if canGestionEquipos() && sameTenantCompanyData(resource.data);

      allow create: if canGestionEquipos()
        && request.resource.data.keys().hasOnly([
          'checklistD',
          'checklistD_fallas',
          'checklistD_hasFallas',
          'checklistD_lastAt',
          'codigo',
          'company',
          'equipo',
          'estado',
          'fallaActiva',
          'fallaUpdatedAt',
          'familia',
          'marca',
          'propiedad',
          'responsable',
          'suplente',
          'tenantId',
          'uid',
          'updatedAt'
        ])
        && sameTenantCompanyData(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.checklistD is bool
        && request.resource.data.checklistD == false
        && request.resource.data.checklistD_hasFallas is bool
        && request.resource.data.checklistD_hasFallas == false
        && request.resource.data.checklistD_fallas is list
        && request.resource.data.checklistD_lastAt == null
        && request.resource.data.fallaActiva is bool
        && request.resource.data.fallaActiva == false
        && request.resource.data.fallaUpdatedAt == null
        && request.resource.data.codigo is string
        && request.resource.data.codigo.trim().size() > 0
        && request.resource.data.equipo is string
        && request.resource.data.equipo.trim().size() > 0
        && request.resource.data.familia is string
        && request.resource.data.familia in ['Montacargas','Apilador','Carretilla']
        && request.resource.data.marca is string
        && request.resource.data.propiedad is string
        && request.resource.data.responsable is string
        && request.resource.data.suplente is string
        && request.resource.data.estado is string
        && request.resource.data.estado in ['Activo','Inactivo','Mantenimiento'];

      // Updates existentes pueden ser más finos; por ahora restringimos a gestión equipos dentro del scope.
      allow update: if canGestionEquipos()
        && sameTenantCompanyData(resource.data)
        && sameTenantCompanyData(request.resource.data)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'equipo',
          'responsable',
          'suplente',
          'estado',
          'marca',
          'propiedad',
          'checklistD',
          'checklistD_hasFallas',
          'checklistD_fallas',
          'checklistD_lastAt',
          'fallaActiva',
          'fallaUpdatedAt',
          'updatedAt'
        ])
        && (!('estado' in request.resource.data) || request.resource.data.estado in ['Activo','Inactivo','Mantenimiento'])
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);

      allow delete: if isAdminRequester() && sameTenantCompanyData(resource.data);
    }

    // =========================
    // Checklists diarias
    // =========================
    match /checklists_diarias/{checkId} {
      allow get, list: if authed();

      allow create: if authed()
        && request.resource.data.keys().hasOnly([
          'equipoId',
          'equipo',
          'responsable',
          'familia',
          'marca',
          'respuestas',
          'hasFallas',
          'fallas',
          'creadoPorUid',
          'creadoPorNombre',
          'creadoPorRole',
          'numeroFicha',
          'nombre',
          'createdAt'
        ])
        && request.resource.data.creadoPorUid == request.auth.uid
        && request.resource.data.equipoId is string
        && request.resource.data.equipo is string
        && request.resource.data.responsable is string
        && request.resource.data.familia is string
        && request.resource.data.marca is string
        && request.resource.data.respuestas is map
        && request.resource.data.hasFallas is bool
        && request.resource.data.fallas is list
        && request.resource.data.creadoPorNombre is string
        && request.resource.data.creadoPorRole is string
        && (!('numeroFicha' in request.resource.data) || request.resource.data.numeroFicha is string)
        && (!('nombre' in request.resource.data) || request.resource.data.nombre is string)
        && request.resource.data.createdAt is timestamp;

      allow update, delete: if false;
    }

// =========================
//  Solicitudes OT
// =========================
match /solicitudesOT/{solicitudId} {

  function canSolicitudesOT() {
    return canMantenimientoOT();
  }

  allow get, list: if canSolicitudesOT();

  allow create: if authed() &&
     request.resource.data.keys().hasOnly([
      'solicitanteNombre',
      'solicitanteFicha',
      'fecha',
      'nombreOT',
      'activoReferencia',
      'departamento',
      'departamentoBase',
      'departamentoOtro',
      'lugarProblema',
      'lugarProblemaBase',
      'lugarProblemaOtro',
      'tipoProblema',
      'tipoProblemaBase',
      'tipoProblemaOtro',
      'descripcionOT',
      'notas',
      'OTState',
      'NroSolicitud',
      'createdAt',
      'updatedAt',
      'createdBy',
      'createdByName',
      'tenantId',
      'company',
      'subtasks'
    ])
    && request.resource.data.solicitanteNombre is string
    && request.resource.data.solicitanteFicha is string
    && request.resource.data.fecha is string
    && request.resource.data.nombreOT is string
    && request.resource.data.activoReferencia is string
    && request.resource.data.departamento is string
    && request.resource.data.departamentoBase is string
    && (!('departamentoOtro' in request.resource.data) || request.resource.data.departamentoOtro is string)
    && request.resource.data.lugarProblema is string
    && request.resource.data.lugarProblemaBase is string
    && (!('lugarProblemaOtro' in request.resource.data) || request.resource.data.lugarProblemaOtro is string)
    && request.resource.data.tipoProblema is string
    && request.resource.data.tipoProblemaBase is string
    && (!('tipoProblemaOtro' in request.resource.data) || request.resource.data.tipoProblemaOtro is string)
    && request.resource.data.descripcionOT is string
    && (!('notas' in request.resource.data) || request.resource.data.notas is string)
    && request.resource.data.OTState == 'Solicitada'
    && request.resource.data.NroSolicitud is string
    && request.resource.data.createdAt is timestamp
    && request.resource.data.updatedAt is timestamp
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdByName is string
    && (!('subtasks' in request.resource.data) || request.resource.data.subtasks is list)
    && request.resource.data.nombreOT.trim().size() > 0
    && request.resource.data.activoReferencia.trim().size() > 0
    && request.resource.data.departamento.trim().size() > 0
    && request.resource.data.lugarProblema.trim().size() > 0
    && request.resource.data.tipoProblema.trim().size() > 0
    && request.resource.data.descripcionOT.trim().size() > 0
    && solicitudOtCreateTenantCompanyOk();

  allow update: if canSolicitudesOT()
    && request.resource.data.diff(resource.data).changedKeys().hasOnly([
      'OTState',
      'updatedAt',
      'notas',
      'responsableUid',
      'responsableNombre',
      'responsablesUids',
      'responsablesNombres'
    ])
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['OTState']) ||
      validOTState(request.resource.data.OTState)
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['updatedAt']) ||
      request.resource.data.updatedAt is timestamp
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['notas']) ||
      request.resource.data.notas is string
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['responsableUid']) ||
      request.resource.data.responsableUid is string
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['responsableNombre']) ||
      request.resource.data.responsableNombre is string
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['responsablesUids', 'responsablesNombres']) ||
      (
        request.resource.data.responsablesUids is list &&
        request.resource.data.responsablesNombres is list &&
        request.resource.data.responsablesUids.size() == request.resource.data.responsablesNombres.size()
      )
    );

  allow delete: if canSolicitudesOT();

  match /subtareas/{subtareaId} {

    allow get, list: if canSolicitudesOT();

    allow create: if canSolicitudesOT()
      && request.resource.data.keys().hasOnly([
        'title',
        'description',
        'status',
        'createdAt',
        'updatedAt',
        'createdBy',
        'createdByName'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.trim().size() > 0
      && (!('description' in request.resource.data) || request.resource.data.description is string)
      && request.resource.data.status is string
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp
      && request.resource.data.createdBy == request.auth.uid
      && request.resource.data.createdByName is string;

    allow update: if canSolicitudesOT()
      && request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'title',
        'description',
        'status',
        'updatedAt',
        'chronoWorkAccumMs',
        'chronoDeadAccumMs',
        'chronoWorkStartedAt',
        'chronoDeadStartedAt'
      ])
      && (
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['title']) ||
        (
          request.resource.data.title is string &&
          request.resource.data.title.trim().size() > 0
        )
      )
      && (
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['description']) ||
        request.resource.data.description is string
      )
      && (
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['status']) ||
        request.resource.data.status is string
      )
      && (
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['updatedAt']) ||
        request.resource.data.updatedAt is timestamp
      )
      && (
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['chronoWorkAccumMs']) ||
        (
          request.resource.data.chronoWorkAccumMs is number &&
          request.resource.data.chronoWorkAccumMs >= 0
        )
      )
      && (
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['chronoDeadAccumMs']) ||
        (
          request.resource.data.chronoDeadAccumMs is number &&
          request.resource.data.chronoDeadAccumMs >= 0
        )
      )
      && (
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['chronoWorkStartedAt']) ||
        !('chronoWorkStartedAt' in request.resource.data) ||
        request.resource.data.chronoWorkStartedAt is timestamp
      )
      && (
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['chronoDeadStartedAt']) ||
        !('chronoDeadStartedAt' in request.resource.data) ||
        request.resource.data.chronoDeadStartedAt is timestamp
      );

    allow delete: if canSolicitudesOT();
  }
}


    // =========================
//  Usuarios Terceros
// =========================
match /usuariosTerceros/{terceroId} {

  function canSaludOcupacional() {
    return authed() && (isAdminRequester() || hasPerm('saludOcupacional'));
  }

  function isOnlyMovimientoUpdate() {
    return request.resource.data.diff(resource.data).changedKeys().hasOnly([
      'entrada','entradaAt','salidaAt','updatedAt'
    ]);
  }

  allow get, list: if canSaludOcupacional();

  allow create: if canSaludOcupacional()
    && request.resource.data.keys().hasOnly([
      'cedula','nombre','empresa','motivo',
      'tenantId','company',
      'entrada',
      'usuarioBloqueado',
      'fotoPerfil','fotoURL','fotoPath','fotoUpdatedAt',
      'createdAt','updatedAt',
      'entradaAt','salidaAt'
    ])
    && request.resource.data.cedula is string
    && request.resource.data.nombre is string
    && request.resource.data.empresa is string
    && request.resource.data.motivo is string
    && request.resource.data.tenantId is string
    && request.resource.data.company is string
    && request.resource.data.entrada is bool
    && request.resource.data.usuarioBloqueado is bool
    && request.resource.data.createdAt is timestamp
    && request.resource.data.updatedAt is timestamp
    && (!('entradaAt' in request.resource.data) || request.resource.data.entradaAt is timestamp)
    && (!('salidaAt' in request.resource.data) || request.resource.data.salidaAt is timestamp)
    && (!('fotoPerfil' in request.resource.data) || request.resource.data.fotoPerfil is string)
    && (!('fotoURL' in request.resource.data) || request.resource.data.fotoURL is string)
    && (!('fotoPath' in request.resource.data) || request.resource.data.fotoPath is string)
    && (!('fotoUpdatedAt' in request.resource.data) || request.resource.data.fotoUpdatedAt is timestamp)
    && request.resource.data.cedula.trim().size() > 0
    && request.resource.data.nombre.trim().size() > 0
    && request.resource.data.empresa.trim().size() > 0;

  allow update: if canSaludOcupacional()
    && request.resource.data.diff(resource.data).changedKeys().hasOnly([
      'nombre','cedula','empresa','motivo',
      'tenantId','company',
      'entrada','entradaAt','salidaAt',
      'usuarioBloqueado',
      'fotoPerfil','fotoURL','fotoPath','fotoUpdatedAt',
      'updatedAt'
    ])
    && (
      resource.data.usuarioBloqueado != true
      ||
      (
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'entrada','salidaAt','updatedAt'
        ])
        && request.resource.data.entrada == false
        && request.resource.data.salidaAt is timestamp
      )
      ||
      (
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'usuarioBloqueado','updatedAt'
        ])
        && request.resource.data.usuarioBloqueado == false
      )
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['entrada']) ||
      request.resource.data.entrada is bool
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['entradaAt']) ||
      request.resource.data.entradaAt is timestamp
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['salidaAt']) ||
      request.resource.data.salidaAt is timestamp
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['updatedAt']) ||
      request.resource.data.updatedAt is timestamp
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['tenantId']) ||
      request.resource.data.tenantId is string
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['company']) ||
      request.resource.data.company is string
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['usuarioBloqueado']) ||
      !('usuarioBloqueado' in request.resource.data) ||
      request.resource.data.usuarioBloqueado is bool
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['fotoPerfil']) ||
      request.resource.data.fotoPerfil is string
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['fotoURL']) ||
      request.resource.data.fotoURL is string
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['fotoPath']) ||
      request.resource.data.fotoPath is string
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['fotoUpdatedAt']) ||
      request.resource.data.fotoUpdatedAt is timestamp
    )
    && (
      isOnlyMovimientoUpdate()
      ||
      (
        request.resource.data.nombre is string
        && request.resource.data.cedula is string
        && request.resource.data.empresa is string
        && request.resource.data.motivo is string
        && request.resource.data.tenantId is string
        && request.resource.data.company is string
        && request.resource.data.nombre.trim().size() > 0
        && request.resource.data.cedula.trim().size() > 0
        && request.resource.data.empresa.trim().size() > 0
        && request.resource.data.motivo.trim().size() > 0
      )
    )
    && (
      !request.resource.data.diff(resource.data).changedKeys().hasAny(['usuarioBloqueado'])
      ||
      (
        isAdminRequester()
        ||
        (
          canSaludOcupacional()
          &&
          (
            (
              request.resource.data.usuarioBloqueado == true
              && (!('usuarioBloqueado' in resource.data) || resource.data.usuarioBloqueado == false)
            )
            ||
            (
              request.resource.data.usuarioBloqueado == false
              && ('usuarioBloqueado' in resource.data) && resource.data.usuarioBloqueado == true
            )
          )
        )
      )
    );
}

// =========================
// ✅ Control Terceros
// =========================
// El cliente (src/services/controlTerceros.js → registrarEvento) envía además
// tenantId y company para acotar por empresa; deben estar en hasOnly.
//
match /controlTerceros/{eventId} {

  function canSaludOcupacional() {
    return authed() && (isAdminRequester() || hasPerm('saludOcupacional'));
  }

  allow get, list: if canSaludOcupacional();

  allow create: if canSaludOcupacional()
    && request.resource.data.keys().hasOnly([
      'terceroId',
      'tipo',
      'dayKey',
      'createdAt',
      'creadoPorUid',
      'terceroNombre',
      'terceroCedula',
      'terceroEmpresa',
      'terceroMotivo',
      'tenantId',
      'company'
    ])
    && request.resource.data.terceroId is string
    && request.resource.data.tipo is string
    && request.resource.data.tipo in ['ENTRADA','SALIDA']
    && request.resource.data.dayKey is string
    && request.resource.data.createdAt is timestamp
    && (!('creadoPorUid' in request.resource.data) || request.resource.data.creadoPorUid is string)
    && (!('terceroNombre' in request.resource.data) || request.resource.data.terceroNombre is string)
    && (!('terceroCedula' in request.resource.data) || request.resource.data.terceroCedula is string)
    && (!('terceroEmpresa' in request.resource.data) || request.resource.data.terceroEmpresa is string)
    && (!('terceroMotivo' in request.resource.data) || request.resource.data.terceroMotivo is string)
    && (!('tenantId' in request.resource.data) || request.resource.data.tenantId is string)
    && (!('company' in request.resource.data) || request.resource.data.company is string);

  allow update, delete: if false;
}
// =========================
    // PESAJE TARIMAS
    // =========================
    match /pesajes/{pesajeId} {

      function canPesaje() {
        return authed();
      }

      /** Email del cliente debe coincidir con el token (o vacío si el proveedor no da email). */
      function validRegistradoEmail() {
        return request.resource.data.registradoPorEmail is string
          && (
            request.auth.token.email == null
              ? request.resource.data.registradoPorEmail == ''
              : request.resource.data.registradoPorEmail == request.auth.token.email
          );
      }

      function validRegistradoNombre() {
        return request.resource.data.registradoPorNombre is string
          && request.resource.data.registradoPorNombre.size() <= 256;
      }

      // Consulta por ID (getDoc con número de tarima)
      allow get: if canPesaje();

      allow list: if false;

      allow create, update: if canPesaje()
        && request.resource.data.keys().hasOnly([
          'numero',
          'peso',
          'unidad',
          'fechaRegistro',
          'registradoPorUid',
          'registradoPorEmail',
          'registradoPorNombre'
        ])
        && request.resource.data.numero is string
        && request.resource.data.numero.size() > 0
        && request.resource.data.numero == pesajeId
        && request.resource.data.peso is number
        && request.resource.data.peso > 0
        && request.resource.data.unidad is string
        && request.resource.data.unidad in ['kg', 'g', 'lb', 'oz', 't']
        && request.resource.data.fechaRegistro is timestamp
        && request.resource.data.registradoPorUid is string
        && request.resource.data.registradoPorUid == request.auth.uid
        && validRegistradoEmail()
        && validRegistradoNombre();

      allow delete: if false;
    }
    
        // =========================
    // Control de marcas (ControlMarcas.jsx)
    // controlMarcas/{YYYY-MM-DD} + subcolección marcas
    // =========================
    match /controlMarcas/{dayId} {
      allow get: if authed();

      // fecha debe coincidir con el id del doc. No exigir createdAt == resource.data.createdAt:
      // cada setDoc manda serverTimestamp() nuevos.
      allow create: if authed()
        && request.resource.data.keys().hasOnly(['fecha', 'createdAt', 'updatedAt'])
        && request.resource.data.fecha is string
        && request.resource.data.fecha == dayId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if authed()
        && request.resource.data.keys().hasAll(['fecha', 'createdAt', 'updatedAt'])
        && request.resource.data.fecha is string
        && request.resource.data.fecha == dayId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.fecha == resource.data.fecha;

      allow delete: if false;

      match /marcas/{marcaId} {
        allow get, list: if authed();

        allow create: if authed()
          && request.resource.data.keys().hasOnly([
            'usuarioId',
            'cedula',
            'nombre',
            'empresa',
            'company',
            'motivo',
            'tenantId',
            'tipo',
            'createdAt',
            'fecha',
            'horaTexto'
          ])
          && request.resource.data.usuarioId is string
          && request.resource.data.cedula is string
          && request.resource.data.nombre is string
          && request.resource.data.empresa is string
          && request.resource.data.company is string
          && request.resource.data.motivo is string
          && request.resource.data.tenantId is string
          && request.resource.data.tipo is string
          && request.resource.data.tipo in ['entrada', 'salida']
          && request.resource.data.createdAt is timestamp
          && request.resource.data.fecha is string
          && request.resource.data.horaTexto is string;

        allow update, delete: if false;
      }
    }
    
    // =========================
    // ✅ VISADOS
    // =========================
    match /visados/{visadoId} {

      function canSaludOcupacional() {
        return authed() && (isAdminRequester() || hasPerm('saludOcupacional'));
      }

      allow get, list: if canSaludOcupacional();

      allow create: if canSaludOcupacional()
		    && request.resource.data.keys().hasOnly([
		      'tenantId','company',
		      'cedula','nombre','nombreLower',
		      'empresa','empresaLower',
		      'motivo','fechaISO',
		      'numeroPatronal','telefonoEmpresa','supervisor','telefonoSupervisor',
		      'tipoTramite','tipoTramiteDetalle',
		      'familiares','familiarNombre','familiarParentesco','familiarPuesto','familiarUnidadVenta',
		      'capAltura','capConfinados','capElectricos','capSoldadura',
		      'empresaAportaCert','aceptaNormas',
		      'createdAt','updatedAt',
		      'creadoPor'
		    ])
		    && request.resource.data.tenantId is string
		    && request.resource.data.company is string
        && request.resource.data.cedula is string
        && request.resource.data.nombre is string
        && request.resource.data.empresa is string
        && request.resource.data.motivo is string
        && request.resource.data.aceptaNormas == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!('nombreLower' in request.resource.data) || request.resource.data.nombreLower is string)
        && (!('empresaLower' in request.resource.data) || request.resource.data.empresaLower is string)
        && (!('fechaISO' in request.resource.data) || request.resource.data.fechaISO is string)
        && (!('numeroPatronal' in request.resource.data) || request.resource.data.numeroPatronal is string)
        && (!('telefonoEmpresa' in request.resource.data) || request.resource.data.telefonoEmpresa is string)
        && (!('supervisor' in request.resource.data) || request.resource.data.supervisor is string)
        && (!('telefonoSupervisor' in request.resource.data) || request.resource.data.telefonoSupervisor is string)
        && (!('tipoTramite' in request.resource.data) || request.resource.data.tipoTramite is string)
        && (!('tipoTramiteDetalle' in request.resource.data) || request.resource.data.tipoTramiteDetalle is string)
        && (!('familiares' in request.resource.data) || request.resource.data.familiares is string)
        && (!('familiarNombre' in request.resource.data) || request.resource.data.familiarNombre is string)
        && (!('familiarParentesco' in request.resource.data) || request.resource.data.familiarParentesco is string)
        && (!('familiarPuesto' in request.resource.data) || request.resource.data.familiarPuesto is string)
        && (!('familiarUnidadVenta' in request.resource.data) || request.resource.data.familiarUnidadVenta is string)
        && (!('capAltura' in request.resource.data) || request.resource.data.capAltura is string)
        && (!('capConfinados' in request.resource.data) || request.resource.data.capConfinados is string)
        && (!('capElectricos' in request.resource.data) || request.resource.data.capElectricos is string)
        && (!('capSoldadura' in request.resource.data) || request.resource.data.capSoldadura is string)
        && (!('empresaAportaCert' in request.resource.data) || request.resource.data.empresaAportaCert is string)
        && (!('creadoPor' in request.resource.data) || request.resource.data.creadoPor == null || request.resource.data.creadoPor is string);

      allow update: if canSaludOcupacional()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'pdfUrl',
          'pdfPath',
          'pdfGeneratedAt',
          'firmado',
          'firmadoAt'
        ])
        && (!('pdfUrl' in request.resource.data) || request.resource.data.pdfUrl is string)
        && (!('pdfPath' in request.resource.data) || request.resource.data.pdfPath is string)
        && (!('pdfGeneratedAt' in request.resource.data) || request.resource.data.pdfGeneratedAt is timestamp)
        && (!('firmado' in request.resource.data) || request.resource.data.firmado is bool)
        && (!('firmadoAt' in request.resource.data) || request.resource.data.firmadoAt is timestamp);

      allow delete: if isAdminRequester();
    }

    // =========================
    // ✅ VISADOS POR FIRMAR
    // =========================
    match /visadosPorFirmar/{docId} {

      function canSaludOcupacional() {
        return authed() && (isAdminRequester() || hasPerm('saludOcupacional'));
      }

      allow get, list: if canSaludOcupacional();

     allow create: if canSaludOcupacional()
		    && request.resource.data.keys().hasOnly([
		      'tenantId','company',
		      'visadoUID',
		      'solicitudNum',
		      'createdAt',
		      'updatedAt',
		      'createdBy',
		      'terceroNombre',
		      'terceroCedula',
		      'terceroEmpresa',
		      'status',
		      'firmaColaborador',
		      'firmaRepresentante'
		    ])
		    && request.resource.data.tenantId is string
		    && request.resource.data.company is string
		    && request.resource.data.visadoUID is string
		    && request.resource.data.solicitudNum is string
		    && request.resource.data.createdAt is timestamp
		    && request.resource.data.updatedAt is timestamp
		    && request.resource.data.createdBy is string
		    && request.resource.data.terceroNombre is string
		    && request.resource.data.terceroCedula is string
		    && request.resource.data.terceroEmpresa is string
		    && request.resource.data.status == "PENDIENTE"
		    && request.resource.data.firmaColaborador is map
		    && request.resource.data.firmaRepresentante is map;

      allow update: if canSaludOcupacional()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'firmaColaborador',
          'firmaRepresentante',
          'updatedAt'
        ])
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isAdminRequester();
    }

    // =========================
    // Aperturas
    // =========================
    match /aperturas/{apId} {
      function canStartApertura() {
        return authed()
          && (
            resource.data.creadoPor == request.auth.uid
            || (('assignedTo' in resource.data) && resource.data.assignedTo == request.auth.uid)
            || (
              !('assignedTo' in resource.data)
              || resource.data.assignedTo == null
              || resource.data.assignedTo == "Libre"
            )
          )
          && (
            !('tiempoIniciada' in resource.data) ||
            resource.data.tiempoIniciada == null
          )
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'assignedTo',
            'assignedToNombre',
            'receptionStarted',
            'tiempoIniciada',
            'iniciadoPorNombre',
            'iniciadoPorUid',
            'estado',
            'updatedAt'
          ])
          && request.resource.data.assignedTo == request.auth.uid
          && (
            !('assignedToNombre' in request.resource.data) ||
            request.resource.data.assignedToNombre == null ||
            request.resource.data.assignedToNombre is string
          )
          && request.resource.data.receptionStarted == true
          && request.resource.data.tiempoIniciada is timestamp
          && request.resource.data.estado == "en_proceso"
          && request.resource.data.iniciadoPorUid == request.auth.uid
          && (
            !('iniciadoPorNombre' in request.resource.data) ||
            request.resource.data.iniciadoPorNombre == null ||
            request.resource.data.iniciadoPorNombre is string
          )
          && (
            !('updatedAt' in request.resource.data) ||
            request.resource.data.updatedAt is timestamp
          );
      }

      allow read, list: if authed();
      allow create: if authed();

      allow update: if
        canStartApertura()
        || resource.data.creadoPor == request.auth.uid
        || (('assignedTo' in resource.data) && resource.data.assignedTo == request.auth.uid);

      allow delete: if
        isAdminRequester()
        || resource.data.creadoPor == request.auth.uid
        || (('assignedTo' in resource.data) && resource.data.assignedTo == request.auth.uid);
    }

    // =========================
    // ✅ Documentación
    // =========================
    match /documentacion/{docId} {

      allow get, list: if canReadDocumentacion();

      allow create: if canCreateDocumentacion()
        && request.resource.data.keys().hasOnly([
          'tenantId',
          'company',
          'title',
          'titleLower',
          'category',
          'categoryLower',
          'description',
          'fileName',
          'size',
          'fileType',
          'ext',
          'url',
          'storagePath',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.tenantId is string
        && request.resource.data.company is string
        && request.resource.data.title is string
        && request.resource.data.title.trim().size() > 0
        && (!('titleLower' in request.resource.data) || request.resource.data.titleLower is string)
        && request.resource.data.category is string
        && request.resource.data.category.trim().size() > 0
        && (!('categoryLower' in request.resource.data) || request.resource.data.categoryLower is string)
        && (!('description' in request.resource.data) || request.resource.data.description is string)
        && request.resource.data.fileName is string
        && request.resource.data.fileName.trim().size() > 0
        && request.resource.data.size is number
        && request.resource.data.size >= 0
        && request.resource.data.fileType is string
        && request.resource.data.fileType == 'application/pdf'
        && (!('ext' in request.resource.data) || request.resource.data.ext is string)
        && request.resource.data.url is string
        && request.resource.data.url.trim().size() > 0
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('^documentacion/[^/]+/[^/]+/.+\\.pdf$')
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);

      allow update: if canUpdateDocumentacion()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'title',
          'titleLower',
          'category',
          'categoryLower',
          'description',
          'updatedAt'
        ])
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.company == resource.data.company
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.fileName == resource.data.fileName
        && request.resource.data.size == resource.data.size
        && request.resource.data.fileType == resource.data.fileType
        && request.resource.data.url == resource.data.url
        && request.resource.data.storagePath == resource.data.storagePath
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.title is string
        && request.resource.data.title.trim().size() > 0
        && (!('titleLower' in request.resource.data) || request.resource.data.titleLower is string)
        && request.resource.data.category is string
        && request.resource.data.category.trim().size() > 0
        && (!('categoryLower' in request.resource.data) || request.resource.data.categoryLower is string)
        && (!('description' in request.resource.data) || request.resource.data.description is string)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);

      allow delete: if canReadDocumentacion() && (
        isAdminRequester() || resource.data.createdBy == request.auth.uid
      );
    }
    
    // =========================
    // AperturasRecepcion
    // =========================
    match /aperturasRecepcion/{apId} {
      function canStartApertura() {
        return authed()
          && (
            resource.data.creadoPor == request.auth.uid ||
            (('assignedTo' in resource.data) && resource.data.assignedTo == request.auth.uid)
          )
          && (
            !('tiempoIniciada' in resource.data) ||
            resource.data.tiempoIniciada == null
          )
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'receptionStarted',
            'tiempoIniciada',
            'iniciadoPorNombre',
            'iniciadoPorUid',
            'estado',
            'updatedAt'
          ])
          && request.resource.data.receptionStarted == true
          && request.resource.data.tiempoIniciada is timestamp
          && request.resource.data.estado == "en_proceso"
          && request.resource.data.iniciadoPorUid == request.auth.uid
          && (
            !('iniciadoPorNombre' in request.resource.data) ||
            request.resource.data.iniciadoPorNombre == null ||
            request.resource.data.iniciadoPorNombre is string
          )
          && (
            !('updatedAt' in request.resource.data) ||
            request.resource.data.updatedAt is timestamp
          );
      }

      allow read, list: if authed();
      allow create: if authed();

      allow update: if
        canStartApertura()
        || resource.data.creadoPor == request.auth.uid
        || (('assignedTo' in resource.data) && resource.data.assignedTo == request.auth.uid)
        || (
          (
            !('assignedTo' in resource.data) ||
            resource.data.assignedTo == null ||
            resource.data.assignedTo == "Libre"
          )
          && ('assignedTo' in request.resource.data)
          && request.resource.data.assignedTo == request.auth.uid
        );

      allow delete: if
        isAdminRequester()
        || resource.data.creadoPor == request.auth.uid
        || (('assignedTo' in resource.data) && resource.data.assignedTo == request.auth.uid);
    }

    // =========================
    // ✅ Recepcion Cofersa
    // =========================
    match /recepcionCofersa_lotes/{loteId} {
      allow get, list: if canRecepcionCofersa();

      allow create: if canRecepcionCofersa()
        && request.resource.data.creadoPor == request.auth.uid;

      allow update, delete: if canRecepcionCofersa() && (
        isAdminRequester() ||
        resource.data.creadoPor == request.auth.uid
      );
    }
  }
}