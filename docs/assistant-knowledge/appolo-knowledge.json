  "security": {
    "authedRequired": true,
    "adminRoles": [
      "administrativo",
      "dev"
    ],
    "helpers": {
      "isAdminRequester": "role in ['administrativo','dev']",
      "hasPerm": "profiles/{uid}.permisos[clave] == true",
      "sameTenantCompanyData": "doc.tenantId == perfil.tenantId AND doc.company == perfil.company"
    },
    "rules": [
      "No mezclar ni mostrar datos de otro tenantId/company.",
      "Las Cloud Functions releen profiles/{uid} en el servidor; no confían en scope del cliente.",
      "Mantenimiento: admin/dev o permisos.mantenimiento.",
      "Checklists diarias: rol operativo o permisos.saludOcupacional."
    ]
  },
  "cloudFunctions": [
    {
      "name": "sendEquipoQrLabel",
      "region": "us-central1",
      "type": "onCall",
      "description": "Genera un PNG QR de un equipo y lo envía por correo (Gmail SMTP). Revalida perfil + tenant/company contra equipos/{id} y exige permiso de mantenimiento."
    },
    {
      "name": "getOvertimeRecords",
      "region": "us-central1",
      "type": "onCall",
      "description": "Lee la vista de asistencia (SQL Server/Bit2), calcula horas extra (semana vs fin de semana) y filtra por coordinador (dev ve todo)."
    },
    {
      "name": "decideOvertimeRecord",
      "region": "us-central1",
      "type": "onCall",
      "description": "Aprueba o rechaza un registro de horas extra (overtimeApprovals)."
    },
    {
      "name": "getOvertimeCoordinators",
      "region": "us-central1",
      "type": "onCall",
      "description": "Lista coordinadores distintos y su email configurado."
    },
    {
      "name": "saveCoordinatorEmails",
      "region": "us-central1",
      "type": "onCall",
      "description": "Guarda el mapeo coordinador -> email en appConfig/overtimeCoordinatorEmails."
    },
    {
      "name": "testSqlConnection",
      "region": "us-central1",
      "type": "onCall",
      "description": "Utilidad de diagnóstico de conexión SQL."
    }
  ],
  "faqSeeds": [
    {
      "q": "¿Cómo uso las áreas de trabajo?",
      "topic": "navegacion"
